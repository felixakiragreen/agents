print -r -- '--- the stamp cycle: a register the rig will not fire from -------------'
# a stamp becomes argv — `-n <mantle>-<stamp>-NN`, run by zsh — so a Name carrying a space
# would split the launch in two and one starting with `-` would read as a flag (013-F9,
# arriving from the register this time). The panel refuses to open, the way it refuses a
# preset on a reserved key — and it refuses wherever it is fired from, because a broken
