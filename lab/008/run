printf '  per keystroke, the stamp resolved with it: %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 500 ))
start=\$EPOCHREALTIME
for i in {1..50}; do _summon_ordinal_scan; done
printf '  per panel open, the one pass over the log:  %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 50 ))" ) > $LAB/out/name-onepass.txt 2>&1
