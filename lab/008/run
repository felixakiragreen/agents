srender() {	# <out> <directory> <t presses> [mantle-key] [columns]
	( cd $CITY/$2 && zsh -f $LAB/render.zsh $SSAND ${5:-200} "${4-a}" fable high 1 2 '' 0 $3 ) \
		> $LAB/out/stamp-$1.txt
}
sstamp() {	# <name> <expected stamp> <out> — the whole composed command, byte for byte
	line "$1" 1 \
		"CLAUDE_CONFIG_DIR=~/.claude-thg-fgreen claude --model fable --effort high -n $2 \"/color green\"" \
		$LAB/out/stamp-$3.txt
}
srender t0 bob 0 ; srender t1 bob 1 ; srender t2 bob 2 ; srender t3 bob 3
