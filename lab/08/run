print -r -- '--- usage: a failed fetch never damages what is already cached --------'
cp $USANDBOX/log/usage/.claude-thg-fgreen.json $LAB/out/cache-before.json
for mode in fail garbage; do
	zsh -f $LAB/fetch.zsh $USANDBOX $mode > $LAB/out/fetch-$mode.txt 2>&1
	if cmp -s $LAB/out/cache-before.json $USANDBOX/log/usage/.claude-thg-fgreen.json; then
		print -r -- "  PASS  a $mode fetch leaves the previous cache byte-identical"
	else
		print -r -- "  FAIL  a $mode fetch damaged the cache"; (( fails++ ))
	fi
done
count 'and it says so per account rather than failing silently' 3 '  FAILED   ' $LAB/out/fetch-fail.txt
if [[ -z $(print -rn -- $USANDBOX/log/usage/*.tmp(N)) ]]; then
	print -r -- '  PASS  atomic writes leave no .tmp behind, on success or failure'
else
	print -r -- '  FAIL  a temporary cache file was left behind'; (( fails++ ))
fi

print -r -- '--- usage: token hygiene --------------------------------------------'
absent 'no token byte in any cache the fetcher wrote' 'FAKE-TOKEN' \
	$USANDBOX/log/usage/.claude-thg-fgreen.json
absent 'no token byte in curl argv — `ps` cannot leak it' 'FAKE-TOKEN' $LAB/out/shim-curl.txt
absent 'no token byte in the keychain call either'        'FAKE-TOKEN' $LAB/out/shim-security.txt
python3 - "$LAB/out" <<'PY' || fails=$(( fails + 1 ))
import os, sys
needle = b"FAKE-TOKEN-DO-NOT-LOG-9f3a"
hits = []
for dp, dn, fn in os.walk(sys.argv[1]):
	for f in fn:
		p = os.path.join(dp, f)
		try:
			if open(p, "rb").read().find(needle) >= 0: hits.append(p)
		except Exception: pass
print(f"  {'PASS' if not hits else 'FAIL'}  no token byte in any of the {sum(len(f) for _,_,f in os.walk(sys.argv[1]))} artefacts this harness produced")
for h in hits: print(f"          leaked into: {h}")
sys.exit(1 if hits else 0)
PY

