check 'the selected theater is bold, ✓ inline' 'bold ⟨bob ✓⟩' $LAB/out/theater-t0.txt
count 'no .summon-theaters ⇒ no theater row at all' 0 '[t]heater' \
	$LAB/out/theater-nofile.txt
trender elsewhere carrier 1
tstamp 'the theater travels with the file, not the directory name' \
	architect-lunchbox-01 elsewhere
trender nofile hexwright 1
