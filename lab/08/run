	'usage    0  sess —         week —         fable —' $UP
check 'a fresh account renders used% and the pacing delta, columns aligned' \
	'         1  sess 42%+31    week 61%-13    fable 12%+55' $UP
check 'a bucket the account does not have renders —, the rest still render' \
	'         2  sess 78%-13    week 45%+2     fable —' $UP
check 'headroom is green'                    'fg=green ⟨+31⟩' $UP
check 'burning faster than the clock is red' 'fg=red ⟨-13⟩'   $UP
check 'the Fable bucket carries its own delta' 'fg=green ⟨+55⟩' $UP
check 'a stale line greys its furniture — the window name, not the figure' 'fg=8 ⟨sess⟩' $UP
count 'no figure is ever dimmed: a used% never carries a grey span' 0 'fg=8 ⟨sess 78%' $UP
count 'and the delta keeps its colour when stale — red is the point' 2 'fg=red ⟨-13⟩' $UP
check 'a stale delta reads green just the same when there is headroom' 'fg=green ⟨+2⟩' $UP
check 'a stale bucket with no figure to protect greys whole' 'fg=8 ⟨fable —⟩' $UP
check 'a no-cache line greys whole for the same reason' 'fg=8 ⟨sess —       ⟩' $UP
check 'the usage label closes the gradient — purple (S0: the magenta slot)' \
	'fg=magenta ⟨usage    ⟩' $UP
count 'the fresh line wears no grey at all, furniture included' 0 \
	'fg=8 ⟨sess 42%+31  ⟩' $UP
count 'exactly one window name is greyed per stale line, not per panel' 1 'fg=8 ⟨week⟩' $UP
widest $LAB/out/usage-60-plain.txt 60
check 'the block survives 60 columns without wrapping a cell' \
	'         1  sess 42%+31    week 61%-13    fable 12%+55' $LAB/out/usage-60-plain.txt

print -r -- '--- usage: panel-open refresh ---------------------------------------'
zsh -f $LAB/usage-seed.zsh $USANDBOX mixed
zsh -f $LAB/spawn.zsh $USANDBOX > $LAB/out/spawn.txt 2>&1
line 'panel open refetches only the cold caches, and leaves the fresh one alone' 1 \
	'SPAWNED personal thg-doorbell' $LAB/out/spawn.txt
# and on a real 60-column screen, with every cache fresh so nothing races the paint
zsh -f $LAB/usage-seed.zsh $USANDBOX fresh
( cd $THEATER/hive && SANDBOX=$USANDBOX SUMMON_COLUMNS=60 expect $LAB/usage.exp $LAB/out/usage-pty.txt $LAB/rc.zsh ) > /dev/null 2>&1
sed -E $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' $LAB/out/usage-pty.txt | tr '\r' '\n' > $LAB/out/usage-pty-plain.txt
check 'live 60-column pty: the usage block paints on a real screen' \
	'usage    0  sess 17%+13' $LAB/out/usage-pty-plain.txt
raw 'and the delta reaches the terminal green' $'\e[32m' $LAB/out/usage-pty.txt
raw 'and red where the burn outruns the clock' $'\e[31m' $LAB/out/usage-pty.txt

print -r -- '--- usage: the keystroke loop stays fork-free ------------------------'
: > $LAB/out/paint-forks.txt
zsh -f -c "source $USANDBOX/summon.zsh 2>/dev/null
COLUMNS=200
_summon_load; _summon_state_load
# every external command the usage path could reach, made loud
security() { print -r -- security >> $LAB/out/paint-forks.txt }
curl()     { print -r -- curl     >> $LAB/out/paint-forks.txt }
shasum()   { print -r -- shasum   >> $LAB/out/paint-forks.txt }
mv()       { print -r -- mv       >> $LAB/out/paint-forks.txt }
for i in {1..200}; do _summon_panel 3 '' 0; done"
if [[ ! -s $LAB/out/paint-forks.txt ]]; then
	print -r -- '  PASS  200 paints over three live caches invoked no external command'
else
	print -r -- "  FAIL  a paint forked: $(sort -u $LAB/out/paint-forks.txt | tr '\n' ' ')"
	(( fails++ ))
fi

print -r -- '--- input delay -----------------------------------------------------'
print -r -- "  host: $(uptime | sed 's/.*load/load/')"
zsh -f -c "source $SANDBOX/summon.zsh 2>/dev/null
COLUMNS=200
_summon_load; _summon_state_load
typeset -F start=\$EPOCHREALTIME
for i in {1..500}; do _summon_load; _summon_state_load; done
printf '  per invocation (2 TSV reads + state, no forks): %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 500 ))
start=\$EPOCHREALTIME
for i in {1..500}; do _summon_panel 3 '' 0; done
printf '  per keystroke  (full panel render + resolve):   %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 500 ))"
# and the same two, now with three usage caches re-read on every single paint
zsh -f -c "source $USANDBOX/summon.zsh 2>/dev/null
COLUMNS=200
_summon_load; _summon_state_load
typeset -F start=\$EPOCHREALTIME
for i in {1..500}; do _summon_load; _summon_state_load; done
printf '  per invocation, usage configured:               %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 500 ))
start=\$EPOCHREALTIME
for i in {1..500}; do _summon_panel 3 '' 0; done
printf '  per keystroke,  usage configured (3 caches):    %.3f ms\n' \
	\$(( (\$EPOCHREALTIME - start) * 1000 / 500 ))"

print -r -- '--- telemetry -------------------------------------------------------'
print -r -- "  $(wc -l < $LOG | tr -d ' ') lines · modes: $(for m in refire pick eject abort; do print -rn -- "$m $(grep -c "\"mode\":\"$m\"" $LOG) "; done)"
python3 - "$LOG" <<'PY' || fails=$(( fails + 1 ))
import json, sys
need = {"ts","mode","n","keys","account","mantle","model","effort","color","name","cmd"}
rows, bad = [], 0
for i, line in enumerate(open(sys.argv[1]), 1):
	try:
		rec = json.loads(line)
	except Exception as e:
		print(f"  FAIL  line {i} is not JSON: {e}"); bad += 1; continue
	rows.append(rec)
	if set(rec) != need:
		print(f"  FAIL  line {i} field set off by {sorted(set(rec) ^ need)}"); bad += 1
	if not isinstance(rec["n"], int):
		print(f"  FAIL  line {i} n is not a number: {rec['n']!r}"); bad += 1
if not bad:
	print(f"  PASS  {len(rows)} lines, all well-formed JSONL with the full field set")
# the floors D36 fixes: refire 2 · one-field change 3 · fresh preset 3–4 · eject 2
for mode, n, what in (("refire",2,"^G ⏎ — the 2-key refire"), ("pick",3,"one-field change"),
							 ("pick",4,"preset + account, and cascade + override"),
							 ("eject",2,"^G . — the sticky config itself"), ("abort",2,"^G Esc")):
	hit = [r for r in rows if r["mode"] == mode and r["n"] == n]
	print(f"  {'PASS' if hit else 'FAIL'}  {mode} at {n} keys — {what}")
	bad += 0 if hit else 1
bare = [r for r in rows if r["mode"] in ("pick","refire") and r["mantle"] is None]
ok = bare and all(r["color"] is None and r["name"] == "hive-01" for r in bare)
print(f"  {'PASS' if ok else 'FAIL'}  bare is inferred from mantle/color = null, not a mode — and stamps the theater alone")
bad += 0 if ok else 1
fired = [r for r in rows if r["mode"] != "abort"]
ok = all(r["name"] and f' -n {r["name"]}' in r["cmd"] for r in fired)
print(f"  {'PASS' if ok else 'FAIL'}  every one of the {len(fired)} fired records carries its stamp, and its cmd carries it as -n")
bad += 0 if ok else 1
ok = all(r["name"] is None for r in rows if r["mode"] == "abort")
print(f"  {'PASS' if ok else 'FAIL'}  every abort stamps null — nothing fired, so nothing counted")
bad += 0 if ok else 1
lineage = [r["name"] for r in fired if r["name"].startswith("architect-hive-")]
ok = lineage == ["architect-hive-%02d" % i for i in range(1, len(lineage) + 1)] and len(lineage) == 9
print(f"  {'PASS' if ok else 'FAIL'}  the architect lineage ran 01..{len(lineage):02d} in order — no gap, no repeat, one per fire")
bad += 0 if ok else 1
invalid = [r for r in rows if r["keys"] == "^GZ⏎"]
ok = len(invalid) == 1 and invalid[0]["n"] == 3 and invalid[0]["mode"] == "refire"
print(f"  {'PASS' if ok else 'FAIL'}  an invalid key is ignored, counted in n, and kept in keys")
bad += 0 if ok else 1
ok = all(r["keys"].startswith("^G") for r in rows) and any(r["keys"] == "^G⏎" for r in rows)
print(f"  {'PASS' if ok else 'FAIL'}  every line carries its raw keystrokes, ^G included")
bad += 0 if ok else 1
yank = [r for r in rows if "y" in r["keys"]]
ok = len(yank) == 1 and yank[0]["n"] == 6
print(f"  {'PASS' if ok else 'FAIL'}  the y press is counted (a pick at 6 keys)")
bad += 0 if ok else 1
sys.exit(1 if bad else 0)
PY

print -r -- '--- refire fidelity -------------------------------------------------'
# a refire repeats the configuration, not the session: since row 13 the one byte that must
# differ is the ordinal, because what it launches is a new session and needs its own handle
pick=$(grep -m1 '"mode":"pick"' $LOG | sed -e 's/.*"cmd":"//' -e 's/","keys".*//')
rep=$(grep -m1 '"mode":"refire"' $LOG | sed -e 's/.*"cmd":"//' -e 's/","keys".*//')
if [[ -n $rep && ${pick/architect-hive-01/} == ${rep/architect-hive-02/} ]]; then
	print -r -- '  PASS  refire cmd byte-identical to the pick it repeats, but for the ordinal'
else
	print -r -- "  FAIL  refire != pick\n          pick:   $pick\n          refire: $rep"
	(( fails++ ))
fi
if [[ $pick == *' -n architect-hive-01 '* && $rep == *' -n architect-hive-02 '* ]]; then
	print -r -- '  PASS  ...and the ordinal advanced by exactly one: 01 → 02'
else
	print -r -- '  FAIL  the refire did not advance the lineage by one'; (( fails++ ))
fi

print -r -- '--- derived summons, every preset -----------------------------------'
zsh -f -c "source $SANDBOX/summon.zsh 2>/dev/null; _summon_load
for k in \$_summon_preset_keys; do
	_summon_mantle_key=\$k
	_summon_model=\${\${(ps:\t:)_summon_preset[\$k]}[2]}
	_summon_effort=\${\${(ps:\t:)_summon_preset[\$k]}[3]}
	_summon_account_key=\$_summon_account_keys[1]
	_summon_resolve
	print -r -- \"    \$_summon_summons\"
done"

print -r -- '--- summon-stats ----------------------------------------------------'
sed -n '/summon-stats ·/,/leverage/p' $PLAIN | sed '/^$/d'
# the reporter parses JSON with zsh builtins — cross-check its arithmetic against python
typeset -a want=(${(z)"$(python3 -c 'import json,sys
rows=[json.loads(l) for l in open(sys.argv[1])]
print(len(rows), sum(r["n"] for r in rows), sum(len(r["cmd"] or "") for r in rows))' $LAB/out/log-at-stats.jsonl)"})
report="$(grep -F 'invocations ·' $PLAIN) $(grep -F 'leverage' $PLAIN)"
expected="$want[1] invocations · $want[2] keys · $want[3] chars"
if [[ $report == *"$want[1] invocations"* && $report == *" $want[2] spent"* && $report == *" $want[3] chars"* ]]; then
	print -r -- "  PASS  counts agree with python ($expected)"
else
	print -r -- "  FAIL  counts disagree with python — expected: $expected"
	(( fails++ ))
fi

print -r -- ''
print -r -- "$fails failure(s)"
exit $(( fails > 0 ))
