print -r -- '--- usage: pacing arithmetic and the response parser ------------------'
# a sandbox of its own: the drive above ran with no log/usage at all, which is exactly the
# v1.1 panel, and these arms are about to create one
USANDBOX=$LAB/out/usage-sandbox
mkdir -p $USANDBOX
cp $RIG/summon.zsh $RIG/presets.tsv $RIG/accounts.tsv $USANDBOX/
cp -R $LAB/fixtures $USANDBOX/
zsh -f $LAB/usage.zsh $USANDBOX > $LAB/out/usage-unit.txt 2>&1
U=$LAB/out/usage-unit.txt
check 'reset imminent: the whole window counts as elapsed' \
	'reset imminent               used=42  → +58' $U
check 'reset already past: elapsed clamps at 100, never beyond' \
	'reset just passed            used=42  → +58' $U
check 'used ahead of the clock reads negative' \
	'used ahead of clock          used=90  → -40' $U
check 'used nothing: the delta is the whole elapsed window' \
	'used nothing                 used=0   → +50' $U
check 'a reset further out than one window clamps elapsed at 0' \
	'reset a window away          used=10  → -10' $U
check 'dead level on pace is +0, and it is signed' \
	'dead level                   used=50  → +0' $U
check 'half rounds away from zero, up'   'half rounds up               used=42  → +1' $U
check 'half rounds away from zero, down' 'half rounds down             used=42  → -1' $U
check "the brief's worked session example: 42% used at 73% elapsed" \
	'session window               used=42  → +31' $U
check "the brief's worked week example: 61% used at 48% elapsed" \
	'week window                  used=61  → -13' $U
check 'a timestamp the rig cannot parse is refused, not guessed' 'EPOCH junk refused, value 0' $U
check 'the full payload yields all three buckets' \
	'PARSE full → 3 bucket(s): sess 42 1786140000, week 61 1786644000, fable 12 1786644000' $U
check 'a payload with no Fable limit yields two, not a fabricated third' \
	'PARSE nofable → 2 bucket(s): sess 17 1786140600, week 4 1786528800' $U
check 'an error body yields nothing at all' 'PARSE garbage → 0 bucket(s)' $U
# the epoch arithmetic is hand-rolled (no fork, no TZ), so python is the second opinion
python3 - "$U" <<'PY' || fails=$(( fails + 1 ))
import sys, datetime as dt
bad = 0
seen = 0
for line in open(sys.argv[1]):
	if not line.startswith("EPOCH 2"): continue
	_, iso, got = line.split()
	want = int(dt.datetime.fromisoformat(iso).timestamp())
	seen += 1
	if int(got) != want:
		print(f"  FAIL  {iso}: rig says {got}, python says {want}"); bad += 1
print(f"  {'PASS' if not bad else 'FAIL'}  all {seen} ISO-8601 stamps agree with python to the second")
sys.exit(1 if bad else 0)
PY

