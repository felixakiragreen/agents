#!/usr/bin/env zsh
# lab/08 — the DoD harness: run the rig in a sandbox pty, then assert on what it did.
# The panel is a pure function of the selection and $COLUMNS (render.zsh), so the palette
# and the responsive wrap are asserted byte-exactly with no pty in the way.
#   ./lab/08/run          → transcript + verdicts, artefacts under lab/08/out/
set -u

LAB=${0:A:h}
RIG=${LAB:h:h}/summon
export SANDBOX=$LAB/out/sandbox
TRANSCRIPT=$LAB/out/transcript.txt
PLAIN=$LAB/out/transcript-plain.txt
LOG=$SANDBOX/log/invocations.jsonl

rm -rf $LAB/out
mkdir -p $SANDBOX
cp $RIG/summon.zsh $RIG/presets.tsv $RIG/accounts.tsv $SANDBOX/
cp -R $LAB/fixtures $SANDBOX/				# the rc's usage shims serve these, never the network

# the name-stamp's theater is $PWD's own basename, so every run happens in a named directory
# rather than wherever the harness was invoked from — the stamps below are then byte-exact.
THEATER=$LAB/out/theater
mkdir -p $THEATER/hive $THEATER/atelier $THEATER/hexwright $THEATER/agents $THEATER/foundry
# ...and two directories that file a campaign list of their own, the way bob does: one repo,
# three theaters, the `t` key choosing which one the stamp carries
mkdir -p $THEATER/bob $THEATER/carrier
printf 'bob\nlunchbox\npods\n' | tee $THEATER/bob/.summon-theaters > $THEATER/carrier/.summon-theaters
( cd $THEATER/hive && expect $LAB/drive.exp $TRANSCRIPT $LAB/rc.zsh ) > /dev/null 2>&1
cp $LOG $LAB/out/log-at-stats.jsonl		# what summon-stats saw, before later tests append

# the styled transcript, with the styling taken back off: assertions on what Felix reads.
# A carriage return becomes a newline, not nothing — zle sends one before rewriting a line,
# so deleting them would glue unrelated text into one line and defeat whole-line matching.
sed -E $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' $TRANSCRIPT | tr '\r' '\n' > $PLAIN

typeset -i fails=0
check() {	# <name> <literal> [file]
	if grep -qF -- "$2" ${3:-$PLAIN}; then
		print -r -- "  PASS  $1"
	else
		print -r -- "  FAIL  $1\n          missing: $2"
		(( fails++ ))
	fi
}
matches() {	# <name> <extended regex> [file] — for the one field that legitimately varies: a clock
	if grep -qE -- "$2" ${3:-$PLAIN}; then
		print -r -- "  PASS  $1"
	else
		print -r -- "  FAIL  $1\n          no line matching: $2"
		(( fails++ ))
	fi
}
count() {	# <name> <expected> <literal> [file]
	local -i got=$(grep -cF -- "$3" ${4:-$PLAIN})
	if (( got == $2 )); then
		print -r -- "  PASS  $1 ($got)"
	else
		print -r -- "  FAIL  $1 — expected $2, got $got: $3"
		(( fails++ ))
	fi
}
line() {	# <name> <expected count> <whole line> [file] — exact: a longer line cannot satisfy it
	local -i got=$(grep -cFx -- "$3" ${4:-$PLAIN})
	if (( got == $2 )); then
		print -r -- "  PASS  $1 ($got)"
	else
		print -r -- "  FAIL  $1 — expected $2 whole-line matches, got $got: $3"
		(( fails++ ))
	fi
}
# raw/absent search the untouched transcript, escape bytes and all. Byte search is python's
# job here, not the shell's: zsh pattern-quoting rewrites a raw ESC into printable `\e`,
# and this environment's grep skips files it judges binary — both would report a false miss.
_summon_bytes_in() { python3 -c 'import sys
hay = open(sys.argv[1], "rb").read()
sys.exit(0 if hay.find(sys.argv[2].encode()) >= 0 else 1)' $2 $1 }
raw() {	# <name> <literal> <file>
	if _summon_bytes_in "$2" $3; then
		print -r -- "  PASS  $1"
	else
		print -r -- "  FAIL  $1\n          missing: ${(V)2}"
		(( fails++ ))
	fi
}
absent() {	# <name> <literal> <file> — the same test, inverted: this must NOT be there
	if _summon_bytes_in "$2" $3; then
		print -r -- "  FAIL  $1\n          present: ${(V)2}"
		(( fails++ ))
	else
		print -r -- "  PASS  $1"
	fi
}
widest() {	# <file> <columns> — every rendered line fits, counted in characters not bytes
	local l ; local -i over=0 max=0
	while IFS= read -r l; do
		[[ $l == '--- '* ]] && break			# the panel ends where render.zsh's own sections start
		(( ${#l} > max )) && max=${#l}
		(( ${#l} > $2 )) && (( over++ ))
	done < $1
	if (( over == 0 )); then
		print -r -- "  PASS  every panel line fits $2 columns (widest $max)"
	else
		print -r -- "  FAIL  $over panel line(s) exceed $2 columns (widest $max)"
		(( fails++ ))
	fi
}

# --- the data files are fixtures too (13-F1) --------------------------------------
# The mantle row and the panel's bracket count are DERIVED from presets.tsv and
# accounts.tsv, never typed. A one-line preset edit rotted this harness for a fortnight
# (13-F1) because a data file and its harness sweep were two acts joined only by memory;
# memory is not a guard, so the fixture reads the data. The bracket placement is
# re-implemented here rather than borrowed from the rig — a derivation that called
# _summon_item would assert nothing but itself.
typeset -a PKEY PMANTLE PEFFORT
typeset -A PDUP
typeset -i NACCT=0
presets_read() {	# <presets.tsv> <accounts.tsv>
	local k m e rest
	PKEY=() PMANTLE=() PEFFORT=() PDUP=() NACCT=0
	while IFS=$'\t' read -r k m rest e rest; do
		[[ -z $k || $k == '#'* ]] && continue
		PKEY+=($k) PMANTLE+=($m) PEFFORT+=($e)
		PDUP[$m]=$(( ${PDUP[$m]:-0} + 1 ))
	done < $1
	while IFS=$'\t' read -r k rest; do
		[[ -z $k || $k == '#'* ]] && continue
		(( NACCT++ ))
	done < $2
}
bracketed() {	# <key> <label> → the key bracketed where it falls in the label, else prefixed
	local key=$1 label=$2
	local cut=${${label:l}%%${(b)${key:l}}*}		# `local` sets its names one statement at a time
	[[ $cut == ${label:l} ]] && { print -rn -- "[$key] $label"; return }
	print -rn -- "${label[1,$#cut]}[$key]${label[$#cut+2,-1]}"
}
mantle_row() {	# <selected key> → the whole mantle row the panel must paint
	local item
	local -a items
	local -i i
	for (( i = 1; i <= $#PKEY; i++ )); do
		item=$PMANTLE[i]
		(( PDUP[$PMANTLE[i]] > 1 )) && item+="·$PEFFORT[i]"
		item="● $(bracketed $PKEY[i] $item)"
		[[ $PKEY[i] == $1 ]] && item+=' ✓'
		items+=($item)
	done
	items+=("$(bracketed n none)")
	print -rn -- "mantle   ${(j:  :)items}"
}
# every bracketed item on the panel: the presets, [n]one, the tier keys the rig itself
# names, the accounts, and the four action keys
typeset -i NTIER=$(zsh -fc "source $RIG/summon.zsh 2>/dev/null
	print -r -- \$(( \$#_summon_models + \$#_summon_efforts ))")
items_expected() { print -rn -- $(( $#PKEY + 1 + NTIER + NACCT + 4 )) }
presets_read $RIG/presets.tsv $RIG/accounts.tsv

# --- the panel, rendered without a pty --------------------------------------------
# <file> <columns> <mantle> <model> <effort> <account> <keys> [yank]
render() { ( cd $THEATER/atelier && zsh -f $LAB/render.zsh $SANDBOX $2 "$3" "$4" "$5" "$6" $7 "${8:-}" ) > $LAB/out/$1 }
plain()  { sed -E $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' $LAB/out/$1 > $LAB/out/${1:r}-plain.txt }
render panel-200.txt 200 a fable high 1 2	; plain panel-200.txt
render panel-60.txt   60 a fable high 1 2	; plain panel-60.txt
render panel-bare.txt 60 '' haiku high 2 3	; plain panel-bare.txt
render panel-cold.txt 80 '' '' '' '' 1		; plain panel-cold.txt
render panel-noacct.txt 80 g fable max '' 3 1	; plain panel-noacct.txt
P200=$LAB/out/panel-200-plain.txt

print -r -- '--- the panel: every live hotkey, the selection, the preview -----------'
check 'mantle row, ● swatches, [n]one, ✓ inline on the selected item' \
	"$(mantle_row a)" $P200
check 'model row — haiku is hai[k]u'  'model    [f]able ✓  [o]pus  [s]onnet  hai[k]u' $P200
check 'effort row — [h]igh is high'   'effort   [l]ow  [m]edium  [h]igh ✓  [x]high  [M]ax' $P200
check 'account row'                   'account  [0] personal  [1] thg-fgreen ✓  [2] thg-doorbell' $P200
check 'action row'                    '         [y]ank  [.] eject  [Esc] close  [Enter] invoke' $P200
check 'preview footer states exactly what Enter fires — the name-stamp leading it' \
	'⏎  architect-atelier-01 · fable-high @ thg-fgreen · green · keys: 2' $P200
check 'and the command that footer promised carries the stamp as --name' \
	'CLAUDE_CONFIG_DIR=~/.claude-thg-fgreen claude --model fable --effort high -n architect-atelier-01 "/color green"' \
	$P200
check 'mantle cleared ⇒ [n]one selected' \
	'[n]one ✓' $LAB/out/panel-bare-plain.txt
check 'bare footer: the theater stamp alone, and no colour' \
	'⏎  atelier-01 · haiku-high @ thg-doorbell · keys: 3' $LAB/out/panel-bare-plain.txt
check 'cold state: the footer refuses instead of guessing' \
	'⏎  nothing selected — press a mantle, or a model and an effort · keys: 1' \
	$LAB/out/panel-cold-plain.txt
check 'no account: the footer names the one thing the rig will never guess' \
	'@ no account — press an account digit' $LAB/out/panel-noacct-plain.txt
check 'even a refusal names itself — the stamp needs neither tier nor account' \
	'⏎  grand-architect-02 · fable-max @ no account' $LAB/out/panel-noacct-plain.txt

print -r -- '--- palette (D36) — the spans, each shown over the text it covers ----'
check 'the summon header opens the gradient — blue (S0: the cyan slot)' \
	'fg=cyan ⟨summon⟩' $P200
check 'mantle label green'        'fg=green ⟨mantle   ⟩'  $P200
check 'model label yellow'        'fg=yellow ⟨model    ⟩' $P200
check 'effort label blue — the slot S0 wears orange' 'fg=blue ⟨effort   ⟩' $P200
check 'account label red'         'fg=red ⟨account  ⟩'    $P200
# one bracket pair per item, minus the selected mantle's, which brighten to the foreground
count 'every opening bracket grey — bar the selected mantle' \
	$(( $(items_expected) - 1 )) 'fg=8 ⟨[⟩' $P200
count 'every closing bracket too' $(( $(items_expected) - 1 )) 'fg=8 ⟨]⟩' $P200
check 'the selected mantle brackets brighten to the foreground' 'fg=default ⟨[⟩' $P200
check '...and its ● with them' 'fg=default ⟨●⟩' $P200
check 'unselected item text grey'  'fg=8 ⟨pus⟩'           $P200
check 'an unselected mantle label wears its session colour, not grey' \
	'fg=green ⟨rand-architect⟩' $P200
check 'the selected mantle wears its colour AND bold, ✓ inline' \
	'fg=green,bold ⟨rchitect·high⟩'  $P200
check '...✓ included' 'fg=green,bold ⟨ ✓⟩' $P200
check 'a selected swatchless item is plain bold, its ✓ inline' \
	'bold ⟨ ✓⟩' $P200
check 'preset ● swatch in its session colour — green'              'fg=green ⟨●⟩'  $P200
check 'builder wears blue, rendered through S0 as the cyan slot'   'fg=cyan ⟨●⟩'   $P200
check 'digger wears orange, rendered through S0 as the blue slot'  'fg=blue ⟨●⟩'   $P200
check 'fixer wears yellow — an identity slot'                      'fg=yellow ⟨●⟩' $P200
# the styles above are zle's names for exactly the codes D36 named, so the proof that the
# palette survives to the terminal is the wire itself: grey (fg=8, emitted via terminfo as
# \e[38;5;8m on this box — the same bright-black slot \e[90m names), bold 1, ANSI blue 34
raw 'grey reaches the terminal as \e[38;5;8m (live pty)' $'\e[38;5;8m' $TRANSCRIPT
raw 'bold reaches the terminal as \e[1m (live pty)'   $'\e[1m'  $TRANSCRIPT
raw 'the blue slot (S0 orange) reaches the terminal as \e[34m' $'\e[34m' $TRANSCRIPT
raw 'green reaches the terminal as \e[32m'            $'\e[32m' $TRANSCRIPT
raw 'the cyan slot (S0 blue) reaches the terminal as \e[36m'   $'\e[36m' $TRANSCRIPT
absent 'and no escape reaches the screen as literal ^[[ text' '^[[' $TRANSCRIPT

print -r -- '--- responsive render -----------------------------------------------'
widest $LAB/out/panel-60-plain.txt 60
widest $LAB/out/panel-bare-plain.txt 60
check 'wraps at an item boundary, continuation aligned under the first item' \
	'         ● [A]rchitect·max  ● [b]uilder  ● [D]igger' $LAB/out/panel-60-plain.txt
count 'no item is broken across lines: each survives whole' 1 \
	'● [A]rchitect·max' $LAB/out/panel-60-plain.txt
line 'the same panel is one row per field at full width' 1 "$(mantle_row a)" $P200
# and in a real 60-column terminal: the break must be ours, not the terminal's
( cd $THEATER/hive && SUMMON_COLUMNS=60 expect $LAB/narrow.exp $LAB/out/narrow.txt $LAB/rc.zsh ) > /dev/null 2>&1
sed -E $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' $LAB/out/narrow.txt | tr '\r' '\n' > $LAB/out/narrow-plain.txt
check 'live 60-column pty: the mantle row wraps where we put the break' \
	'mantle   ● [g]rand-architect  ● [a]rchitect·high' $LAB/out/narrow-plain.txt
check 'live 60-column pty: the continuation line is intact and aligned' \
	'         ● [A]rchitect·max ✓  ● [b]uilder  ● [D]igger' $LAB/out/narrow-plain.txt

print -r -- '--- preview footer vs the launch it promised (live pty) --------------'
# one gesture on the state the drive left behind, so the paint is whole and comparable
( cd $THEATER/hive && expect $LAB/preview.exp $LAB/out/preview.txt $LAB/rc.zsh ) > /dev/null 2>&1
sed -E $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' $LAB/out/preview.txt | tr '\r' '\n' > $LAB/out/preview-plain.txt
check 'the panel opens pre-selected from log/state, and says what Enter will fire' \
	'⏎  architect-hive-09 · opus-max @ thg-fgreen · green · keys: 1' $LAB/out/preview-plain.txt
check 'Enter then fires exactly that — stamp, mantle, tier and account' \
	'SHIM cfg=/Users/felix/.claude-thg-fgreen args=--model opus --effort max -n architect-hive-09 /color green' \
	$LAB/out/preview-plain.txt

print -r -- '--- sticky state ----------------------------------------------------'
check 'cold: Enter with nothing selected fires nothing' 'summon: nothing selected'
count 'and `.` refuses to eject nothing, same refusal' 2 'summon: nothing selected'
count 'Ctrl-G a 2 ⏎ (4 keys) → architect · fable-high on thg-doorbell, then 3 refires of it' 4 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model fable --effort high -n architect-hive-'
for nn in 01 02 03 04; do
	line "  ...and each was born its own session: architect-hive-$nn" 1 \
		"SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model fable --effort high -n architect-hive-$nn /color green"
done
check 'the panel opens pre-selected from state' 'architect-hive-02 · fable-high @ thg-doorbell'
check 'Esc closes and discards this panel'      'summon: closed — changes discarded'
count 'Esc and a second Ctrl-G both close, both discard' 2 'summon: closed — changes discarded'
line 'cascade + single-field override: A then k → architect · haiku-max' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model haiku --effort max -n architect-hive-05 /color green'
line 'fresh preset on the sticky account (3 keys) — a mantle of its own counts from 01' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model opus --effort high -n fixer-hive-01 /color yellow'
line 'm = [m]edium: the model stays opus' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model opus --effort medium -n fixer-hive-02 /color yellow'
line 'k = hai[k]u: the effort stays medium' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model haiku --effort medium -n fixer-hive-03 /color yellow'
line '[n]one → bare launch: the theater stamp alone, no colour, no prompt' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-doorbell args=--model haiku --effort medium -n hive-01'
line 'override + account (6 keys) → the architect lineage continues at 06' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-fgreen args=--model opus --effort max -n architect-hive-06 /color green'
line 'and the refire after two ejects: 08, because an eject fires and so counts' 1 \
	'SHIM cfg=/Users/felix/.claude-thg-fgreen args=--model opus --effort max -n architect-hive-08 /color green'
count 'nothing fires but Enter: 11 launches across 20 gestures' 11 'SHIM cfg='
check 'non-empty buffer survives (push-input)' 'KEEPME'

print -r -- '--- state file ------------------------------------------------------'
if [[ -r $SANDBOX/log/state ]]; then
	print -r -- "  PASS  log/state written on fire: $(tr '\t' '=' < $SANDBOX/log/state | tr '\n' ' ')"
else
	print -r -- '  FAIL  no log/state after 11 launches'; (( fails++ ))
fi
check 'state holds the last fired configuration, not the last panel' $'mantle\tA' $SANDBOX/log/state
check 'state keeps the overridden model, not the one the preset cascaded' \
	$'model\topus' $SANDBOX/log/state
if [[ -e $SANDBOX/log/last ]]; then
	print -r -- '  FAIL  log/last is retired but still written'; (( fails++ ))
else
	print -r -- '  PASS  log/last retired — log/state is the only sidecar'
fi

print -r -- '--- eject -----------------------------------------------------------'
check '`^G .` ejects the sticky config itself (2 keys), stamp and all' \
	'CLAUDE_CONFIG_DIR=~/.claude-thg-fgreen claude --model opus --effort max -n architect-hive-07 "/color green"'
check '`^G g 0 .` ejects an editable resolved command — and the Grand Architect carries no theater' \
	'CLAUDE_CONFIG_DIR=~/.claude claude --model fable --effort max -n grand-architect-01 "/color green"'
count 'the ejected command was never executed' 0 'args=--model fable --effort max -n grand-architect'
check 'the eject is logged with its description' '"mode":"eject"' $LOG

print -r -- '--- the name-stamp: the lineage counter, against a fixture log --------'
# a sandbox with a hand-written log, so every ordinal below is derived from history the
# assertion can see. The theater is $PWD's own basename, so each render cds to the one it
# means, and what is asserted is the composed command — the thing that actually launches.
NAMES=$LAB/out/name-sandbox
mkdir -p $NAMES/log
cp $RIG/summon.zsh $RIG/presets.tsv $RIG/accounts.tsv $NAMES/
nrender() {	# <out> <theater> <mantle-key> [bump]
	( cd $THEATER/$2 && zsh -f $LAB/render.zsh $NAMES 200 "$3" fable high 1 2 '' ${4:-0} ) \
		> $LAB/out/name-$1.txt
}
stamp() {	# <name> <expected stamp> <file> [tail] — the whole composed command, byte for byte
	line "$1" 1 \
		"CLAUDE_CONFIG_DIR=~/.claude-thg-fgreen claude --model fable --effort high -n $2${4- \"/color green\"}" \
		$LAB/out/name-$3.txt
}
nrender virgin hexwright a
stamp 'a log with no history at all: the lineage opens at 01' architect-hexwright-01 virgin

cat > $NAMES/log/invocations.jsonl <<'JSONL'
{"ts":"2026-08-10T09:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","cmd":"claude --model fable --effort high -n architect","keys":"^Ga0⏎"}
{"ts":"2026-08-10T10:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":null,"cmd":"claude --model fable --effort high -n architect","keys":"^Ga0⏎"}
{"ts":"2026-08-11T09:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-hexwright-03","cmd":"claude -n architect-hexwright-03","keys":"^Ga0⏎"}
{"ts":"2026-08-11T11:00:00-0400","mode":"refire","n":2,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-hexwright-07","cmd":"claude -n architect-hexwright-07","keys":"^G⏎"}
{"ts":"2026-08-11T12:00:00-0400","mode":"refire","n":2,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-hexwright-05","cmd":"claude -n architect-hexwright-05","keys":"^G⏎"}
{"ts":"2026-08-12T09:00:00-0400","mode":"eject","n":2,"account":"personal","mantle":"grand-architect","model":"fable","effort":"max","color":"green","name":"grand-architect-09","cmd":"claude -n grand-architect-09","keys":"^G."}
{"ts":"2026-08-12T10:00:00-0400","mode":"pick","n":3,"account":"personal","mantle":null,"model":"fable","effort":"high","color":null,"name":"hexwright-02","cmd":"claude -n hexwright-02","keys":"^Gn⏎"}
{"ts":"2026-08-12T11:00:00-0400","mode":"abort","n":2,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":null,"cmd":"claude -n architect-hexwright-99","keys":"^G⎋"}
JSONL

nrender seeded  hexwright a
nrender crossed agents    a
nrender ga      hexwright g
nrender ga-else agents    g
nrender bare    hexwright ''
stamp 'the ordinal is one past the highest ever fired, not past the last one logged' \
	architect-hexwright-08 seeded
stamp 'a legacy record with no name field, and a null one, are both skipped' \
	architect-hexwright-08 seeded
stamp 'theater isolates the lineage: the same mantle elsewhere starts at 01' \
	architect-agents-01 crossed
stamp 'the bare lineage is the theater alone, counted separately and wearing no colour' \
	hexwright-03 bare ''
check 'the Grand Architect carries no theater — one office, so the segment says nothing' \
	'-n grand-architect-10 "/color green"' $LAB/out/name-ga.txt
if cmp -s <(grep -F CLAUDE_CONFIG_DIR $LAB/out/name-ga.txt) \
			 <(grep -F CLAUDE_CONFIG_DIR $LAB/out/name-ga-else.txt); then
	print -r -- '  PASS  ...so the Grand Architect counts one lineage across every theater'
else
	print -r -- '  FAIL  the Grand Architect stamp changed with the theater'; (( fails++ ))
fi
nrender bumped-up   agents    a 8
nrender bumped-down agents    a -5
nrender bumped-back hexwright a -3
stamp 'the panel bump seeds a hand-counted lineage: eight + on a virgin lineage' \
	architect-agents-09 bumped-up
stamp 'and the floor is 01, however far down the bump is pressed' \
	architect-agents-01 bumped-down
stamp 'a bump down corrects a live lineage without restarting it' \
	architect-hexwright-05 bumped-back
check 'and the panel footer carries the bumped name in full, before anything fires' \
	'⏎  architect-agents-09 · fable-high @ thg-fgreen · green · keys: 2' $LAB/out/name-bumped-up.txt
check '...the floored one too — the footer and the launch can never disagree' \
	'⏎  architect-agents-01 · fable-high @ thg-fgreen · green · keys: 2' $LAB/out/name-bumped-down.txt

print -r -- '--- the theater cycle: the campaign the stamp carries -----------------'
# a sandbox whose log has already seen two of the three campaigns bob hosts, so the ordinals
# below prove the lineages are counted apart as well as stamped apart
TSAND=$LAB/out/theater-sandbox
mkdir -p $TSAND/log
cp $RIG/summon.zsh $RIG/presets.tsv $RIG/accounts.tsv $TSAND/
cat > $TSAND/log/invocations.jsonl <<'JSONL'
{"ts":"2026-08-20T09:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-bob-02","cmd":"claude -n architect-bob-02","keys":"^Ga0⏎"}
{"ts":"2026-08-20T10:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-bob-04","cmd":"claude -n architect-bob-04","keys":"^Ga0⏎"}
{"ts":"2026-08-20T11:00:00-0400","mode":"pick","n":4,"account":"personal","mantle":"architect","model":"fable","effort":"high","color":"green","name":"architect-pods-01","cmd":"claude -n architect-pods-01","keys":"^Ga0⏎"}
