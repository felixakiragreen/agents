trender() {	# <out> <directory> <t presses> [mantle-key] [columns]
	( cd $THEATER/$2 && zsh -f $LAB/render.zsh $TSAND ${5:-200} "${4-a}" fable high 1 2 '' 0 $3 ) \
		> $LAB/out/theater-$1.txt
}
tstamp() {	# <name> <expected stamp> <out> — the whole composed command, byte for byte
	line "$1" 1 \
		"CLAUDE_CONFIG_DIR=~/.claude-thg-fgreen claude --model fable --effort high -n $2 \"/color green\"" \
		$LAB/out/theater-$3.txt
}
