#!/usr/bin/env expect
# lab/08 — the panel in a real 60-column terminal: our wrap must land the break, not the
# terminal's. Open, look, close — no launch.
# usage: narrow.exp <transcript> <rc.zsh>

set timeout 15
log_file -noappend [lindex $argv 0]
spawn zsh -f -i
send "source [lindex $argv 1]\r"
expect "READY"

send "\a"
expect "keys: 1"
send "\033"
expect "closed"
send "exit\r"
expect eof
