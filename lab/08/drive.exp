#!/usr/bin/env expect
# lab/08 — drives the Ctrl-G panel through every DoD path in one live zsh + pty.
# Enter, and only Enter, fires: every selection below is confirmed before it launches.
# usage: drive.exp <transcript> <rc.zsh>

set timeout 15
log_file -noappend [lindex $argv 0]
spawn zsh -f -i
send "source [lindex $argv 1]\r"
expect "READY"

# a mark round-trips the prompt: seeing its output means the previous line is done.
# (Do not wait on the prompt itself — zsh trails escape sequences after it.)
proc mark {n} {
	send "print -r -- MARK$n\r"
	expect "MARK$n\r"
}

# T2 — 4 keys: ^G a 2 ⏎ → architect · fable-high on thg-doorbell, clipboard untouched
send "\a"
expect "keys: 1"
send "a"
expect "keys: 2"
send "2"
expect "keys: 3"
send "\r"
expect "SHIM"
mark 2

# T3 — 3 keys: ^G ^G ⏎ arms the last invocation, shows it resolved, then fires it
send "\a"
expect "keys: 1"
send "\a"
expect "ARMED"
send "\r"
expect "SHIM"
mark 3

# T4 — 3 keys: ^G d ⏎ fires on the last-used account (doorbell, from T2)
send "\a"
expect "keys: 1"
send "d"
expect "keys: 2"
send "\r"
expect "SHIM"
mark 4

# T5 — `.` ejects an editable command instead of launching it; ^U clears the line.
# Eject the one config nothing else in this drive launches, so the assertion cannot
# match a stray echo: grand-architect · fable-max.
send "\a"
expect "keys: 1"
send "g"
expect "grand-architect ✓"
send "."
expect "grand-architect"
send "\025"
mark 5

# T5b — `^G .` with nothing selected ejects the last invocation (log/last is the default
# source), at the 2-key floor. Asserted through the log: dispatcher, from T4.
send "\a"
expect "keys: 1"
send "."
expect "CLAUDE_CONFIG_DIR"
send "\025"
mark 6

# T6 — esc aborts
send "\a"
expect "keys: 1"
send "\033"
expect "aborted"
mark 7

# T7 — a line in progress survives: push-input restores it after the launch
send "print -r -- KEEPME"
send "\a"
expect "keys: 1"
send "a"
expect "keys: 2"
send "1"
expect "keys: 3"
send "\r"
expect "SHIM"
expect "KEEPME"
mark 8

# T8 — bare, 5 keys: ^G f x 1 ⏎ → fable · xhigh on thg-fgreen, no name/colour/prompt
send "\a"
expect "keys: 1"
send "f"
expect "fable ✓"
send "x"
expect "xhigh ✓"
send "1"
expect "keys: 4"
send "\r"
expect "SHIM"
mark 9

# T9 — y yanks the summons, then account + Enter (5 keys)
send "\a"
expect "keys: 1"
send "A"
expect "keys: 2"
send "y"
expect "yank summons ✓"
send "2"
expect "keys: 4"
send "\r"
expect "SHIM"
mark 10

# T10 — a selection key alone never fires: hold at the panel, then abort
send "\a"
expect "keys: 1"
send "g"
expect "grand-architect ✓"
send "0"
expect "personal ✓"
send "\033"
expect "aborted"
mark 11

# T11 — Enter with nothing selected fires nothing
send "\a"
expect "keys: 1"
send "\r"
expect "nothing selected"
mark 12

# T12 — the reporter
send "summon-stats\r"
expect "leverage"
mark 13

send "exit\r"
expect eof
